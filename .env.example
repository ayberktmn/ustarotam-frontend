# Public URL is embedded at build time; rebuild after changing it.
NEXT_PUBLIC_API_BASE_URL=https://api.ustarotam.com/api/v1
# Server-only. Keep equal to the public URL when using the localhost gateway.
API_INTERNAL_BASE_URL=https://api.ustarotam.com/api/v1
# Set the actual HTTPS frontend origin before a production build.
SITE_URL=http://localhost:3000
# Demo panel access must remain disabled for production.
NEXT_PUBLIC_WORKSHOP_PANEL_PREVIEW=false
